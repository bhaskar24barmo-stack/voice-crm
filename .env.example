# Server-side only (never prefix with NEXT_PUBLIC_). Also add these in Vercel > Settings > Environment Variables.
OPENROUTER_API_KEY=
# Pick a model at https://openrouter.ai/models. Defaults to openrouter/auto.
OPENROUTER_MODEL=openrouter/auto

# Same values your login already uses. If missing, /app runs in demo mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Where signed-out users are sent
NEXT_PUBLIC_LOGIN_PATH=/login
