NEXT_PUBLIC_SITE_URL=https://your-domain.com
# Supabase (free tier works): Project Settings -> API
SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # server only. Never commit or expose.
# Google Search Console HTML-tag verification token (content="...")
NEXT_PUBLIC_GSC_VERIFICATION=

# ---- CRM (all server-side; never prefix with NEXT_PUBLIC_) ----
# AI assistant via OpenRouter: https://openrouter.ai/keys . Pick any model id from https://openrouter.ai/models
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Audio transcription (optional). Any OpenAI-compatible /audio/transcriptions endpoint, for example:
#   OpenAI: https://api.openai.com/v1/audio/transcriptions  (model: whisper-1)
#   Groq:   https://api.groq.com/openai/v1/audio/transcriptions  (model: whisper-large-v3-turbo)
STT_API_URL=
STT_API_KEY=
STT_MODEL=
# Currency shown for lead values (ISO code), e.g. USD, INR, EUR
NEXT_PUBLIC_CURRENCY=USD
